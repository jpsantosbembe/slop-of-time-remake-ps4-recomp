From 2b683c68440eb56f763a3296dda19ad080dd12c7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jo=C3=A3o=20Bembe?= <jpbembe@gmail.com>
Date: Sat, 7 Nov 2026 21:58:17 -0300
Subject: [PATCH 03/13] ocarina-ps4: IA_MULTI_VGT_PARAM do Gladius (regras do
 Hawaii e uconfig 0x30960)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A GPU do PS4 Pro travava sempre num DrawIndexed instanciado. As regras do
Hawaii (WD_SWITCH_ON_EOP com instâncias, PARTIAL_VS_WAVE_ON com
SWITCH_ON_EOI, VGT_FLUSH do GS) não valiam para o CHIP_GLADIUS, e o valor só
ia para o context reg 0x28AA8, enquanto o Neo usa o uconfig 0x258 (R_030960),
como mostrou o galaxy-recomp. ORBIS_NEO_VGT=0|1|2 para A/B (padrão 1).
---
 src/amd/vulkan/radv_cmd_buffer.c | 48 ++++++++++++++++++++++++++++++--
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 924bd60..1b8c88e 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -7209,6 +7209,39 @@ static const struct radv_prim_vertex_count prim_size_table[] = {
    [V_008958_DI_PT_2D_TRI_STRIP] = {0, 0},
 };
 
+/* ocarina-ps4 (frente H, 2026-11-07): IA_MULTI_VGT_PARAM no PS4 Pro em modo Neo (Gladius).
+ *
+ * A GPU travava SEMPRE num DrawIndexed instanciado (30 índices, 7 instâncias); o mesmo draw com 1 instância passava e
+ * descartar os draws com instâncias > 1 fazia o jogo rodar. Duas coisas do RADV não cobriam o Gladius:
+ *  - as regras do Hawaii (o outro GFX7 de 4 motores): "Hawaii hangs if instancing is enabled and WD_SWITCH_ON_EOP is 0"
+ *    e o PARTIAL_VS_WAVE_ON com SWITCH_ON_EOI testam family == CHIP_HAWAII;
+ *  - o registrador: no GFX7 o RADV escreve só o context reg 0x28AA8. No galaxy-recomp (GNM, mesmo console) o Neo só
+ *    destravou com o WD_SWITCH_ON_EOP escrito no UCONFIG 0x258 (= R_030960, o endereço que o GFX9 usa).
+ *
+ * ORBIS_NEO_VGT (só vale no Gladius):
+ *   0  como o upstream (A/B);
+ *   1  regras do Hawaii no Gladius + o mesmo valor também no uconfig R_030960 (padrão);
+ *   2  como 1, e WD_SWITCH_ON_EOP=1 em todo draw (o mais conservador, custa vazão de primitivas). */
+static int
+radv_orbis_neo_vgt_mode(const struct radeon_info *gpu_info)
+{
+   static int mode = -1;
+
+   if (gpu_info->family != CHIP_GLADIUS)
+      return 0;
+   if (mode < 0) {
+      const char *const e = getenv("ORBIS_NEO_VGT");
+      mode = e != NULL ? atoi(e) : 1;
+      if (mode < 0 || mode > 2)
+         mode = 1;
+      mesa_logi("radv/orbis: ORBIS_NEO_VGT=%d (%s)", mode,
+                mode == 0   ? "upstream: so o context reg, sem as regras do Hawaii"
+                : mode == 1 ? "regras do Hawaii + uconfig 0x30960"
+                            : "regras do Hawaii + uconfig 0x30960 + WD_SWITCH_ON_EOP sempre");
+   }
+   return mode;
+}
+
 static uint32_t
 radv_get_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_draw, bool indirect_draw,
                             bool count_from_stream_output, uint32_t draw_vertex_count, unsigned topology,
@@ -7272,7 +7305,13 @@ radv_get_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_d
    ia_switch_on_eoi = cmd_buffer->state.ia_multi_vgt_param.ia_switch_on_eoi;
    partial_vs_wave = cmd_buffer->state.ia_multi_vgt_param.partial_vs_wave;
 
+   const int neo_vgt = radv_orbis_neo_vgt_mode(gpu_info);
+   const bool hawaii_rules = gpu_info->family == CHIP_HAWAII || neo_vgt >= 1;
+
    if (gpu_info->gfx_level >= GFX7) {
+      if (neo_vgt >= 2)
+         wd_switch_on_eop = true;
+
       /* WD_SWITCH_ON_EOP has no effect on GPUs with less than
        * 4 shader engines. Set 1 to pass the assertion below.
        * The other cases are hardware requirements. */
@@ -7284,7 +7323,7 @@ radv_get_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_d
       /* Hawaii hangs if instancing is enabled and WD_SWITCH_ON_EOP is 0.
        * We don't know that for indirect drawing, so treat it as
        * always problematic. */
-      if (gpu_info->family == CHIP_HAWAII && (instanced_draw || indirect_draw))
+      if (hawaii_rules && (instanced_draw || indirect_draw))
          wd_switch_on_eop = true;
 
       /* Performance recommendation for 4 SE Gfx7-8 parts if
@@ -7307,7 +7346,7 @@ radv_get_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_d
 
       /* Required by Hawaii and, for some special cases, by GFX8. */
       if (ia_switch_on_eoi &&
-          (gpu_info->family == CHIP_HAWAII ||
+          (hawaii_rules ||
            (gpu_info->gfx_level == GFX8 &&
             /* max primgroup in wave is always 2 - leave this for documentation */
             (radv_cmdbuf_has_stage(cmd_buffer, MESA_SHADER_GEOMETRY) || max_primgroup_in_wave != 2))))
@@ -7329,7 +7368,7 @@ radv_get_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_d
        * The hw doc says all multi-SE chips are affected, but amdgpu-pro Vulkan
        * only applies it to Hawaii. Do what amdgpu-pro Vulkan does.
        */
-      if (gpu_info->family == CHIP_HAWAII && ia_switch_on_eoi) {
+      if (hawaii_rules && ia_switch_on_eoi) {
          bool set_vgt_flush = indirect_draw;
          if (!set_vgt_flush && instanced_draw) {
             uint32_t num_prims = radv_prims_for_vertices(&prim_vertex_count, draw_vertex_count);
@@ -7380,6 +7419,9 @@ radv_emit_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_
          radeon_set_uconfig_reg_idx(&pdev->info, R_030960_IA_MULTI_VGT_PARAM, 4, ia_multi_vgt_param);
       } else if (gpu_info->gfx_level >= GFX7) {
          radeon_set_context_reg_idx(R_028AA8_IA_MULTI_VGT_PARAM, 1, ia_multi_vgt_param);
+         /* O Neo lê o IA_MULTI_VGT_PARAM do uconfig 0x258 (ver radv_orbis_neo_vgt_mode). */
+         if (radv_orbis_neo_vgt_mode(&pdev->info) >= 1)
+            radeon_set_uconfig_reg(R_030960_IA_MULTI_VGT_PARAM, ia_multi_vgt_param);
       } else {
          radeon_set_context_reg(R_028AA8_IA_MULTI_VGT_PARAM, ia_multi_vgt_param);
       }
